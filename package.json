{
  "name": "mcp-stagehand",
  "version": "1.3.1",
  "description": "MCP server for StageHand — let AI helpers manage indexes, lore, and Flow Builder with a personal sh_ key.",
  "main": "build/index.js",
  "bin": {
    "mcp-stagehand": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stagehand",
    "discord",
    "codex",
    "claude",
    "chatgpt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/",
    "README.md",
    "SETUP.md",
    "CODEX_AND_CHATGPT.md",
    "smithery.yaml"
  ],
  "bugs": {
    "url": "https://discord.gg/nd6FUaBpaV"
  },
  "homepage": "https://stagehand.quest/docs/stagehand/ai-helpers",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.50",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "dotenv": "^16.5.0",
    "express": "^5.3.0",
    "zod": "^3.25.13"
  }
}
